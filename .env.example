# Sao chép thành .env để ghi đè cấu hình docker-compose (KHÔNG commit file .env)
WQ_PG_PASSWORD=wq
# Mô hình dùng trong streaming/API: tên built-in (locf, linear | persistence, seasonal_naive) hoặc file .joblib
WQ_IMPUTER=locf
WQ_FORECASTER=seasonal_naive
# Ví dụ khi TV3/TV4 bàn giao:
# WQ_IMPUTER=/app/models/imputer_kalman.joblib
# WQ_FORECASTER=/app/models/forecaster_xgb.joblib
# Tốc độ phát lại: số giây dữ liệu trong 1 giây thực (3600 = 1 giờ dữ liệu/giây)
REPLAY_SPEEDUP=3600
# Tài nguyên Spark
SPARK_WORKER_CORES=2
SPARK_WORKER_MEMORY=2g
WQ_STREAM_CORES=4
