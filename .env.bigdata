# Chế độ Big Data đầy đủ: 235 trạm USGS + HDFS (1 NameNode, 2 DataNode) + ETL trên cụm Spark.
# Chạy:  docker compose --env-file .env.bigdata up -d
# Cần máy ≥ 6 CPU / 12 GB RAM cho Docker; tải dữ liệu lần đầu ~30-60 phút (giới hạn tốc độ API USGS).
COMPOSE_PROFILES=hdfs
WQ_STATIONS_FILE=/app/config/stations_large.json
WQ_LANDING_PATH=/app/data/raw/usgs_large
WQ_RAW_GZIP=1
WQ_RAW_PATH=hdfs://namenode:8020/wq/raw/usgs
WQ_LAKE_PATH=hdfs://namenode:8020/wq/lake
WQ_CHECKPOINT_PATH=hdfs://namenode:8020/wq/checkpoints
WQ_ETL_MASTER=spark://spark-master:7077
